DATABASE_URL=postgresql://user:pass@host:5432/db

BETTER_AUTH_SECRET=openssl_rand_hex_32_output
BETTER_AUTH_URL=http://localhost:3000
# Inlined into the client bundle at `next build` time — must match the
# public origin. Override at build time (e.g. Dockerfile build arg).
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base64-encoded 32 random bytes. Wraps per-user prompt DEKs.
# Generate: openssl rand -base64 32
PROMPT_MASTER_KEY=
